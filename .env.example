# Copy to .env.local and uncomment what you need.

# Extra dev hosts, comma-separated. Next already allows localhost and the host
# it started with; add a LAN IP or Tailscale/MagicDNS name here.
# ALLOWED_DEV_ORIGINS=192.168.1.20,my-machine.tailnet.ts.net

# Optional storage overrides.
# DATABASE_PATH=./data/game-library.db
# MIGRATIONS_PATH=./drizzle

# Optional: keep the SteamGridDB key out of the database.
# STEAMGRIDDB_API_KEY=

# Docker Compose only: address the published port binds to.
# BIND_ADDRESS=127.0.0.1

# Demo deployment: serve the client-only /demo route at / and skip migrations.
# DEMO_MODE=1
